    <rdfs:range rdf:resource="https://w3id.org/cm4di#ObligationArtifact"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#issues">
    <rdfs:label>issues</rdfs:label>
    <rdfs:comment>Associates a CredentialServiceProvider with the Credential it issues.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#CredentialServiceProvider"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#Credential"/>
