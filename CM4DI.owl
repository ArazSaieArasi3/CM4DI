        </owl:unionOf>
      </rdf:Description>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#PolicyArtifact"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#obligationRef">
    <rdfs:label>obligationRef</rdfs:label>
    <rdfs:comment>References to obligations or advice attached to an authorization result.</rdfs:comment>
