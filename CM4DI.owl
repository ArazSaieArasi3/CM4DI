      <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#issuedBy">
        <rdfs:label>issuedBy</rdfs:label>
        <rdfs:comment>Inverse of issues.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/cm4di#Credential"/>
        <rdfs:range rdf:resource="https://w3id.org/cm4di#CredentialServiceProvider"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#schemaRef">
    <rdfs:label>schemaRef</rdfs:label>
    <rdfs:comment>Reference to a schema artifact.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Credential"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#SchemaArtifact"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#issuanceTime">
    <rdfs:label>issuanceTime</rdfs:label>
    <rdfs:comment>Time of issuance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Credential"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#authenticationMethodRef">
    <rdfs:label>authenticationMethodRef</rdfs:label>
    <rdfs:comment>References to authentication methods.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Authentication"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#Method"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#claimValue">
    <rdfs:label>claimValue</rdfs:label>
    <rdfs:comment>Value asserted by the claim.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Claim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#lifecycleStatus">
    <rdfs:label>lifecycleStatus</rdfs:label>
    <rdfs:comment>Lifecycle status of the digital identity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#DigitalIdentity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#validFrom">
    <rdfs:label>validFrom</rdfs:label>
    <rdfs:comment>Lower bound of validity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Credential"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#subscriptionType">
    <rdfs:label>subscriptionType</rdfs:label>
    <rdfs:comment>Type of subscription or membership.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Subscriber"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#validUntil">
    <rdfs:label>validUntil</rdfs:label>
    <rdfs:comment>Upper bound of validity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Credential"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#trustReferenceRef">
    <rdfs:label>trustReferenceRef</rdfs:label>
    <rdfs:comment>Reference from an IdentityProvider to a TrustReference.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#IdentityProvider"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#TrustReference"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#hasAttribute">
    <rdfs:label>hasAttribute</rdfs:label>
    <rdfs:comment>Associates an IdentitySubject with one or more intrinsic identity attributes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#IdentitySubject"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#IdentityAttribute"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#assuranceHint">
    <rdfs:label>assuranceHint</rdfs:label>
    <rdfs:comment>Lightweight indication of assurance or strength.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Authenticator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#bindingStatus">
    <rdfs:label>bindingStatus</rdfs:label>
    <rdfs:comment>Current binding status of the authenticator.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Authenticator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/cm4di#mappingNote">
    <rdfs:label>mappingNote</rdfs:label>
    <rdfs:comment>Short note about alignment or operational interpretation.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#domainRef">
    <rdfs:label>domainRef</rdfs:label>
    <rdfs:comment>Reference to an organizational or technical domain.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#IdentityContext"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#Domain"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#reflects">
    <rdfs:label>reflects</rdfs:label>
    <rdfs:comment>Associates a DigitalIdentity with the IdentityAttributes it reflects.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#DigitalIdentity"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#IdentityAttribute"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#authenticationContextRef">
    <rdfs:label>authenticationContextRef</rdfs:label>
    <rdfs:comment>Reference to the authentication context class or assurance context.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Authentication"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#AssuranceContext"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#displayName">
    <rdfs:label>displayName</rdfs:label>
    <rdfs:comment>Human-readable label for the party.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Party"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#authenticatorRef">
    <rdfs:label>authenticatorRef</rdfs:label>
    <rdfs:comment>References to authenticators used in authentication.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Authentication"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#Authenticator"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#claimEvidenceRef">
    <rdfs:label>claimEvidenceRef</rdfs:label>
    <rdfs:comment>References to supporting claim evidence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Claim"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#EvidenceArtifact"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#protocolRef">
    <rdfs:label>protocolRef</rdfs:label>
    <rdfs:comment>References to issuance or management protocols.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#CredentialServiceProvider"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#Protocol"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#representationFormat">
    <rdfs:label>representationFormat</rdfs:label>
    <rdfs:comment>Concrete operational format of the representation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#DigitalIdentity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#asserts">
    <rdfs:label>asserts</rdfs:label>
    <rdfs:comment>Associates a Claim with one or more asserted IdentityAttributes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Claim"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#IdentityAttribute"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#status">
    <rdfs:label>status</rdfs:label>
    <rdfs:comment>Current status of the party.</rdfs:comment>
    <rdfs:domain>
      <rdf:Description rdf:nodeID="N4980d08b90654e51b80e398eebe5e859">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/cm4di#Party"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#issuerAuthorityRef">
    <rdfs:label>issuerAuthorityRef</rdfs:label>
    <rdfs:comment>Reference to an issuing authority.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#CredentialServiceProvider"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#Authority"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#about">
    <rdfs:label>about</rdfs:label>
    <rdfs:comment>Associates a Claim with the IdentitySubject it is about.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Claim"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#IdentitySubject"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#subjectOfClaim">
        <rdfs:label>subjectOfClaim</rdfs:label>
        <rdfs:comment>Inverse of about.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/cm4di#IdentitySubject"/>
        <rdfs:range rdf:resource="https://w3id.org/cm4di#Claim"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#enrollmentTime">
    <rdfs:label>enrollmentTime</rdfs:label>
    <rdfs:comment>Time of enrollment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Enrollment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#evidenceReference">
    <rdfs:label>evidenceReference</rdfs:label>
    <rdfs:comment>References to trust evidence or attestations.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#TrustReference"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#EvidenceArtifact"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#claimIssuedAt">
    <rdfs:label>claimIssuedAt</rdfs:label>
    <rdfs:comment>Time of issuance or assertion of the claim.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Claim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/cm4di#hasStereotype">
    <rdfs:label>hasStereotype</rdfs:label>
    <rdfs:comment>Stores the OntoUML stereotype associated with a modeling element.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#claimRef">
    <rdfs:label>claimRef</rdfs:label>
    <rdfs:comment>References to claims participating in authentication.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Authentication"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#Claim"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#verificationPolicyRef">
    <rdfs:label>verificationPolicyRef</rdfs:label>
    <rdfs:comment>Reference to verification policies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Verifier"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#PolicyArtifact"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#hasParticipant">
    <rdfs:label>hasParticipant</rdfs:label>
    <rdfs:comment>Associates a participant-bearing entity with an event in which it participates, following the direction used in the CM4DI conceptual diagram.</rdfs:comment>
    <rdfs:domain>
      <rdf:Description rdf:nodeID="N93f7340e966043ff9945d3d109767724">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/cm4di#IdentitySubject"/>
          <rdf:Description rdf:about="https://w3id.org/cm4di#Verifier"/>
          <rdf:Description rdf:about="https://w3id.org/cm4di#Authenticator"/>
          <rdf:Description rdf:about="https://w3id.org/cm4di#Claim"/>
          <rdf:Description rdf:about="https://w3id.org/cm4di#RelyingParty"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:domain>
    <rdfs:range>
      <rdf:Description rdf:nodeID="Nfc9c60a751574aa19434992b5c30867c">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/cm4di#Authentication"/>
          <rdf:Description rdf:about="https://w3id.org/cm4di#Authorization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
    <cm4di:mappingNote>The conceptual diagram uses participant-to-event edges labeled hasParticipant. This OWL operationalization preserves that relation label and direction for compatibility with CM4DI.</cm4di:mappingNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#manages">
    <rdfs:label>manages</rdfs:label>
    <rdfs:comment>Associates an IdentityProvider with one or more DigitalIdentity instances it manages.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#IdentityProvider"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#DigitalIdentity"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#managedBy">
        <rdfs:label>managedBy</rdfs:label>
        <rdfs:comment>Inverse of manages.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/cm4di#DigitalIdentity"/>
        <rdfs:range rdf:resource="https://w3id.org/cm4di#IdentityProvider"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#credentialType">
    <rdfs:label>credentialType</rdfs:label>
    <rdfs:comment>Type or category of the credential.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Credential"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#managedCredentialType">
    <rdfs:label>managedCredentialType</rdfs:label>
    <rdfs:comment>Credential type managed by the CSP.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#CredentialServiceProvider"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#statusReference">
    <rdfs:label>statusReference</rdfs:label>
    <rdfs:comment>Reference to status, revocation, or lifecycle information.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Credential"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#EvidenceArtifact"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#serviceEndpointRef">
    <rdfs:label>serviceEndpointRef</rdfs:label>
    <rdfs:comment>References to provider service endpoints.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#IdentityProvider"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#ServiceEndpoint"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#trustScore">
    <rdfs:label>trustScore</rdfs:label>
    <rdfs:comment>Quantitative trust score.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#TrustReference"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#confidenceLevel">
    <rdfs:label>confidenceLevel</rdfs:label>
    <rdfs:comment>Confidence or quality indicator of the attribute.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#IdentityAttribute"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://w3id.org/cm4di">
    <dcterms:title>CM4DI Ontology</dcterms:title>
    <dcterms:description>Field-complete OWL operationalization of the CM4DI ontology for digital identity with trust integration, grounded in UFO and specified in OntoUML.</dcterms:description>
    <owl:versionInfo>1.3-field-complete</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://w3id.org/cm4di/1.3"/>
    <rdfs:label>CM4DI Ontology</rdfs:label>
    <rdfs:comment>OWL operationalization of the CM4DI conceptual model enriched with the CM4DI Field Registry v0.1.</rdfs:comment>
    <dcterms:creator>Araz Saie Arasi</dcterms:creator>
    <dcterms:creator>Hassan Haghighi</dcterms:creator>
    <dcterms:creator>Hossein Azgomi</dcterms:creator>
    <dcterms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
    <rdfs:seeAlso rdf:resource="https://github.com/ArazSaieArasi3/CM4DI"/>
  </owl:Ontology>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#subjectStatus">
    <rdfs:label>subjectStatus</rdfs:label>
    <rdfs:comment>Current status of the subject.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#IdentitySubject"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#nonceOrSessionBinding">
    <rdfs:label>nonceOrSessionBinding</rdfs:label>
    <rdfs:comment>Session or anti-replay binding value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Authentication"/>
