          <rdf:Description rdf:about="https://w3id.org/cm4di#Authentication"/>
          <rdf:Description rdf:about="https://w3id.org/cm4di#Authorization"/>
          <rdf:Description rdf:about="https://w3id.org/cm4di#TrustReference"/>
          <rdf:Description rdf:about="https://w3id.org/cm4di#IdentitySubject"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#IdentityContext"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#attributeType">
