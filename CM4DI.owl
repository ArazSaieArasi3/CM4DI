    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Credential"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#Claim"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/cm4di#ServiceEndpoint">
    <rdfs:label>ServiceEndpoint</rdfs:label>
    <cm4di:hasStereotype>information object</cm4di:hasStereotype>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#supports">
    <rdfs:label>supports</rdfs:label>
    <rdfs:comment>Associates a Credential with one or more Claims that it supports.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Credential"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#Claim"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#supportedByCredential">
        <rdfs:label>supportedByCredential</rdfs:label>
        <rdfs:comment>Inverse of supports.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/cm4di#Claim"/>
        <rdfs:range rdf:resource="https://w3id.org/cm4di#Credential"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <cm4di:mappingNote>The supports relation is operationalized as Credential-to-Claim, following the current Version 15 conceptual diagram and its intended identity-evidence interpretation.</cm4di:mappingNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#contextRef">
    <rdfs:label>contextRef</rdfs:label>
