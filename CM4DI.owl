      <rdf:Description rdf:nodeID="N290e7f7494014708855b05feeed1f8ee">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/cm4di#Subscriber"/>
          <rdf:Description rdf:about="https://w3id.org/cm4di#Credential"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#Party"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#profileRef">
    <rdfs:label>profileRef</rdfs:label>
    <rdfs:comment>Reference to extended profiles.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#IdentitySubject"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#ProfileArtifact"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#policyRef">
    <rdfs:label>policyRef</rdfs:label>
    <rdfs:comment>Reference to governing policies.</rdfs:comment>
