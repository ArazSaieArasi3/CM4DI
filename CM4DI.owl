    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#identifierScopeRef">
    <rdfs:label>identifierScopeRef</rdfs:label>
    <rdfs:comment>Reference to the scope in which the identifier is valid.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#Identifier"/>
    <rdfs:range rdf:resource="https://w3id.org/cm4di#IdentityContext"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/cm4di#externalVersionRef">
    <rdfs:label>externalVersionRef</rdfs:label>
    <rdfs:comment>Version reference of the external source.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/cm4di#ONTrustTrust"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/cm4di#holderRef">
    <rdfs:label>holderRef</rdfs:label>
