        <mxCell id="oQjTEl268BNgiPaa2CO--128" parent="1" style="rounded=0;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#d5e8d4;fontFamily=Tahoma;fontSize=12;align=center;strokeColor=#82b366;fontStyle=0" value="&lt;span&gt;&lt;b&gt;Author: Araz Saie Arasi&lt;br&gt;Created: 20.01.2026&lt;br&gt;Based on:&amp;nbsp;&lt;a href=&quot;https://github.com/CCMi-FIT/UMLet-OntoUML-palette&quot; target=&quot;_blank&quot;&gt;GitHub Umlet Palette&lt;/a&gt;&lt;br&gt;Last update: 14.02.2026&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="-330" y="590" as="geometry" />
        </mxCell>
        <mxCell id="oQjTEl268BNgiPaa2CO--129" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#f9f7ed;strokeColor=#36393d;spacingLeft=13;labelBackgroundColor=none;fontColor=default;" value="&lt;div&gt;&lt;h2 data-start=&quot;158&quot; data-end=&quot;179&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Ontological Legend&lt;/font&gt;&lt;/h2&gt;&lt;b&gt;«kind» &lt;/b&gt;– Rigid sortal providing an identity principle&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;b&gt;«subkind»&lt;/b&gt; – Rigid specialization inheriting identity from a supertype&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«role»&lt;/b&gt; – Anti-rigid, relationally dependent type&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«relator»&lt;/b&gt; – Entity that mediates material relations between endurants&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«quality»&lt;/b&gt; – Intrinsic moment inhering in a bearer&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«social object»&lt;/b&gt; – Institutionally or socially constructed object&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«information object»&lt;/b&gt; – Representational informational artifact&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«event»&lt;/b&gt; – Occurrent entity unfolding in time&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«value object»&lt;/b&gt; – Abstract value-like entity (engineering abstraction aligned with UFO quality values)&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«mediation»&lt;/b&gt; – Relation between a relator and its mediated endurants&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«characterization»&lt;/b&gt; – Relation between a quality and its bearer&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«participation»&lt;/b&gt; – Relation linking an event and its participants&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;b&gt;«trace»&lt;/b&gt; – Weak semantic alignment without ontological commitment&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="258" width="474" x="-400" y="-301" as="geometry" />
        </mxCell>
